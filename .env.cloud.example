APP_ENV=production
APP_NAME=live-ops-dashboard
TIMEZONE=Asia/Shanghai
PROJECT_ROOT=/app
DEV_AUTH_BYPASS=false
LOG_LEVEL=INFO

# Sites 上线地址。三个值必须使用同一个 HTTPS Sites 域名。
APP_BASE_URL=https://jishi-live-ops-dashboard.chenclya.chatgpt.site
API_BASE_URL=https://jishi-live-ops-dashboard.chenclya.chatgpt.site
FEISHU_REDIRECT_URI=https://jishi-live-ops-dashboard.chenclya.chatgpt.site/auth/feishu/callback
CORS_ORIGINS=["https://jishi-live-ops-dashboard.chenclya.chatgpt.site"]

# 云端 API 独立域名，只由 Sites Worker 请求。
CLOUD_API_DOMAIN=api-dashboard.example.com
SITES_GATEWAY_TOKEN=

POSTGRES_DB=live_ops
POSTGRES_USER=live_ops
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://live_ops:replace_with_url_encoded_password@postgres:5432/live_ops
REDIS_URL=redis://redis:6379/0

JWT_SECRET=
FIELD_ENCRYPTION_KEY=
SESSION_MAX_AGE_DAYS=30

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_LIVE_APP_TOKEN=
FEISHU_LIVE_TABLE_ID=
FEISHU_LIVE_VIEW_ID=
FEISHU_SCHEDULE_APP_TOKEN=
FEISHU_SCHEDULE_TABLE_ID=
FEISHU_SCHEDULE_VIEW_ID=
FEISHU_SCHEDULE_YEAR=
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SECRET=
FEISHU_BOT_CHAT_ID=
FEISHU_AUTO_PROVISION_ENABLED=false
FEISHU_AUTO_PROVISION_ROLE=live_manager

LIVE_SYNC_INTERVAL_MINUTES=5
SCHEDULE_SYNC_INTERVAL_MINUTES=30
ALERT_DELAY_MINUTES=15
ALERT_RETRY_LIMIT=3

# 服务器绝对路径；不放入 Git。
MIGRATION_DIR=/opt/live-ops/migration
BACKUP_DIR=/opt/live-ops/backups/postgres
